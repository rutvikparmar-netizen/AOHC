# =============================================================================
# ART OF HEALING CANCER — ENVIRONMENT TEMPLATE
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development, or paste these keys into your
# host's environment settings (Vercel: Project -> Settings -> Environment
# Variables).
#
# THIS FILE IS COMMITTED AND CONTAINS NO REAL VALUES. The file that holds the
# real ones, `.env.local`, is gitignored and must stay that way.
#
# NOTHING HERE IS PREFIXED `NEXT_PUBLIC_`, and that is deliberate: Next inlines
# every `NEXT_PUBLIC_*` value into the CLIENT bundle, so prefixing the database
# URI or an SMTP password would publish it to every visitor. Every variable
# below is read on the server only.
# =============================================================================

# -----------------------------------------------------------------------------
# DATA SOURCE
# -----------------------------------------------------------------------------
# Which implementation the repository layer returns.
#
#   demo     -> the static files in src/data. No database needed. The site
#               runs fully, with placeholder clinical content.
#   mongodb  -> MongoDB Atlas. Required to STORE PATIENT ENQUIRIES and to edit
#               content from the admin console.
#
# Demo is the default when this is unset or misspelled, so a bad deploy renders
# placeholder content rather than throwing on every route.
#
# ⚠️  ONE THING DOES NOT WORK ON DEMO, AND IT MATTERS: with DATA_SOURCE=demo
# there is nowhere to put an enquiry. The forms say so plainly rather than
# thanking someone for a message that was never stored. Set this to `mongodb`
# before the site takes real patient enquiries.
DATA_SOURCE=demo

# -----------------------------------------------------------------------------
# MONGODB — required when DATA_SOURCE=mongodb
# -----------------------------------------------------------------------------
# Atlas connection string, including credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE

# Database name, kept separate from the URI so staging can point at a different
# database without a second connection string.
MONGODB_DB=art_of_healing_cancer

# DNS override for the SRV lookup — LOCAL DEVELOPMENT ONLY, and only when
# needed. `mongodb+srv://` requires a DNS SRV query; some machines run a
# resolver that refuses those, and the driver then fails with
# `querySrv ECONNREFUSED`, which looks like an outage but is a DNS quirk.
#
# LEAVE THIS UNSET IN PRODUCTION.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# -----------------------------------------------------------------------------
# EMAIL — enquiry acknowledgements and webinar confirmations
# -----------------------------------------------------------------------------
# Set ONE of the two. With neither, messages are printed to the server console
# and the form tells the visitor their enquiry was received but no email was
# sent — it never claims to have sent one.
#
# Verify whatever you set with:  npm run mail:check
# Send a real test message with: npm run mail:send you@example.com

# Option A — SMTP. The username must be percent-encoded: `@` becomes `%40`.
# Port 465 needs smtps:// (implicit TLS); port 587 needs smtp:// (STARTTLS).
# Zoho, Gmail and most providers require an APP-SPECIFIC password here, not the
# account password.
# SMTP_URL=smtps://user%40domain.com:APP_PASSWORD@smtp.zoho.com:465

# Option B — Resend's HTTP API. Useful when outbound SMTP ports are blocked,
# which is common on serverless hosts.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The From address on every outbound email. Must be an address the transport
# above is authorised to send as, or messages are rejected or junked.
MAIL_FROM=Art of Healing Cancer <no-reply@artofhealingcancer.com>

# Where new patient enquiries are emailed as they arrive. Unset, enquiries are
# still stored and visible in the console — nobody is paged, nothing is lost.
# ENQUIRY_NOTIFY_TO=care@artofhealingcancer.com

# -----------------------------------------------------------------------------
# WEBINARS — optional
# -----------------------------------------------------------------------------
# The join link sent in a registration confirmation. Kept in the environment,
# not in content, so it never appears on a public page: a Zoom link on a public
# page is an open door for anyone who finds it.
# WEBINAR_JOIN_URL=https://us02web.zoom.us/j/XXXXXXXXXX?pwd=XXXXXXXX

# -----------------------------------------------------------------------------
# ADMIN CONSOLE — /admin
# -----------------------------------------------------------------------------
# The built-in console: patient enquiries, webinar registrations, treatments,
# specialists, journal posts and settings.
#
# It has ONE identity. Sign-in is the email and password below, and nothing
# else — there is no second factor, so this password is the only thing
# protecting every patient enquiry in the database. Make it long and unique,
# and keep it in a password manager.
#
# With either variable unset, or a password under 10 characters, every sign-in
# is refused. Changing ADMIN_EMAIL ends every existing console session.
# ADMIN_EMAIL=owner@artofhealingcancer.com
# ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# ADMIN API — optional, for an external dashboard
# -----------------------------------------------------------------------------
# A single long-lived bearer token that lets another application read this
# site's data. The dashboard's SERVER sends it as:
#
#   Authorization: Bearer <key>
#
# Endpoints: /api/admin/summary, /api/admin/leads
#
# MUST BE AT LEAST 32 CHARACTERS, or every admin endpoint refuses. With it
# unset they also refuse, so a forgotten variable closes the API rather than
# opening it.
#
# CALL IT SERVER TO SERVER ONLY. The responses contain patient names, phone
# numbers and clinical notes. There are deliberately no CORS headers, so a
# cross-origin browser fetch is blocked even with a valid key.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# SITE URL — optional
# -----------------------------------------------------------------------------
# Overrides the canonical/Open Graph base URL. Set this on preview and staging
# deployments so they do not advertise the production domain.
# NEXT_PUBLIC_SITE_URL=https://artofhealingcancer.com
